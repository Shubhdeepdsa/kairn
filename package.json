{
  "name": "kairn",
  "version": "0.1.0",
  "description": "Local-first Markdown documentation CLI",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26 <27"
  },
  "bin": {
    "kairn": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:frontend",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.frontend.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && vitest run",
    "docs:lint": "markdownlint-cli2",
    "build:node": "tsc -p tsconfig.build.json",
    "build:frontend": "vite build",
    "dev:frontend": "vite build --watch",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tsdoc": "^0.5.4",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.77.0",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "markdown-it": "^15.0.3",
    "open": "^11.0.4",
    "zod": "^4.6.7"
  }
}

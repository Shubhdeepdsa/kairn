{
  "name": "kairn",
  "version": "0.1.0",
  "description": "Local-first Markdown documentation CLI",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26 <27"
  },
  "bin": {
    "kairn": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && vitest run",
    "docs:lint": "markdownlint-cli2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "jsdom": "^31.0.1",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "markdown-it": "^15.0.3",
    "open": "^11.0.4",
    "zod": "^4.6.7"
  }
}
